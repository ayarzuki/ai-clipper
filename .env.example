# Copy this file to .env and fill in your real keys, then start the server
# with start.bat (it loads .env into the environment before running).
# NEVER commit .env or share your keys.

# Groq — https://console.groq.com/ -> API Keys (free tier available)
# Used for: Whisper ASR (transcription), ~$0.036 per hour of audio
GROQ_API_KEY=gsk_replace_me

# DeepSeek — https://platform.deepseek.com/ -> API keys
# Used for: clip selection LLM (deepseek-flash), ~$0.004 per hour of video
DEEPSEEK_API_KEY=sk-replace_me

# Optional overrides
# PORT=8765
# CLIPPER_FAKE=0
